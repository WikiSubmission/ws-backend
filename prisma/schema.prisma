// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quran {
  id       String    @id @default(uuid())
  language Languages
  qiraat   Qiraats?
  audios   Audio[]
  chapters Chapter[]
}

model Chapter {
  id               String  @id @default(uuid())
  quran            Quran   @relation(fields: [quranId], references: [id])
  quranId          String
  number           Int     @default(1)
  name             String
  revelation_order Int
  verses           Verse[]

  @@unique([quranId, number])
}

model Verse {
  id        String  @id @default(uuid())
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  chapterId String
  number    Int     @default(1)
  content   String
  subtitle  String?
  footnote  String?
  words     Word[]

  @@unique([chapterId, number])
}

model Word {
  id      String @id @default(uuid())
  verse   Verse  @relation(fields: [verseId], references: [id])
  verseId String
  number  Int
  content String
}

model Audio {
  id      String   @id @default(uuid())
  quran   Quran    @relation(fields: [quranId], references: [id])
  quranId String
  reciter String   @default("Unknown")
  root    String
  edition String
  bitrate Bitrates
}

enum Languages {
  ARABIC_TASHKEEL
  ARABIC_NON_TASHKEEL
  TRANSLITERATED
  ENGLISH
  FR_NCH
  TAMIL
  HINDI
  TURKISH
  PERSIAN
}

enum Qiraats {
  HAFIZ
  HAFIZH
  NAFI_AL_MADANI
  IBN_KATHIR_AL_MAKKI
  ABU_AMR_AL_BASRI
  IBN_AMIR_AD_DIMASHQI
  ASIM_AL_KUFI
  HAMZAH_AL_KUFI
  AL_KISAI_AL_KUFI
  ABU_JAFER_AL_MADANI
  JAKOB_AL_HADRAMI
  KHALAF_AL__ASHIR
}

enum Bitrates {
  Kbps32  @map("32")
  Kbps40  @map("40")
  Kbps48  @map("48")
  Kbps64  @map("64")
  Kbps128 @map("128")
  Kbps192 @map("192")
  Kbps320 @map("320")
}
