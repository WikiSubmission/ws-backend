generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Verses {
  uuid          String    @id @default(uuid())
  global_index  Int       @default(autoincrement())
  verse_index   Int
  subtitle      String?
  content       String
  footer        String?
  language      Languages
  chapter_index Int
  chapter_title String
  Words         Words[]

  @@unique([global_index, chapter_index, verse_index, language])
}

model Words {
  uuid          String    @id @default(uuid())
  global_index  Int       @default(autoincrement())
  chapter_index Int
  verse_index   Int
  word_index    Int
  content       String
  root          String
  language      Languages
  
  verse         Verses    @relation(fields: [versesUuid], references: [uuid])
  versesUuid    String

  @@unique([global_index, chapter_index, verse_index, word_index, language])
}

model ChapterMetadata {
  chapter_index        Int    @id
  global_index         Int
  title_english        String
  title_arabic         String
  title_transliterated String
  verse_count          Int
  revelation_order     Int
}

model Gematria {
  letter String @id
  value  Int
}

enum Languages {
  ARABIC_TASHKEEL
  ARABIC_NON_TASHKEEL
  TRANSLITERATED
  ENGLISH
  FRENCH
  TAMIL
  HINDI
  TURKISH
  PERSIAN
  RUSSIAN
  SWEDISH
  GERMAN
  BAHASA
  ARABIC_ROOT
}

enum Qiraats {
  HAFIZ
  HAFIZH
  NAFI_AL_MADANI
  IBN_KATHIR_AL_MAKKI
  ABU_AMR_AL_BASRI
  IBN_AMIR_AD_DIMASHQI
  ASIM_AL_KUFI
  HAMZAH_AL_KUFI
  AL_KISAI_AL_KUFI
  ABU_JAFER_AL_MADANI
  JAKOB_AL_HADRAMI
  KHALAF_AL__ASHIR
}

enum Scripts {
  UTHMANI
  UTHMANI_SIMPLE
  IMLAEI
  IMLAEI_SIMPLE
}
