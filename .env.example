# DB — local server (used when DATABASE_URL is not set, including `just run`)
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_DOMAIN=localhost
DATABASE_NAME=ws_backend
DATABASE_SSL_MODE=disable

# Named environments for the justfile.
# `just export railway` / `just push hetzner` resolve the corresponding URL.
# DATABASE_URL_LOCAL is optional — leave blank to compose from the vars above.
DATABASE_URL_LOCAL=
DATABASE_URL_RAILWAY=
DATABASE_URL_HETZNER=

# Coolify/Hetzner bootstrap (superuser URL, used by `just coolify-init`)
POSTGRES_ADMIN_URL=

# API
TRUSTED_PROXIES=127.0.0.1,192.168.1.1
PORT=8082
GIN_MODE=release
APP_ENV=development

# OpenAI (only needed for `just embed-quran`)
OPENAI_API_KEY=

# Web Push (VAPID). Generate a pair with webpush.GenerateVAPIDKeys() or
# `npx web-push generate-vapid-keys`. The public key must also be exposed to
# the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wikisubmission.org

# User data export (GET/POST /api/v1/me/export).
# Exports are uploaded to a private S3 bucket and delivered as a 30-day
# CloudFront signed URL by email. Leave EXPORTS_BUCKET_NAME blank to disable the
# feature (the endpoint then fails gracefully). Email delivery also requires the
# SMTP_* variables below.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EXPORTS_BUCKET_NAME=
# CloudFront signing for the private exports/* behavior. CLOUDFRONT_PRIVATE_KEY
# holds the PEM contents directly (preferred); CLOUDFRONT_PRIVATE_KEY_PATH is a
# fallback file path.
CLOUDFRONT_PUBLIC_KEY_ID=
CLOUDFRONT_BASE_URL=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PRIVATE_KEY_PATH=

# SMTP (required for export delivery and other transactional email).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
