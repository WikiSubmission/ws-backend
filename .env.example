# DB — local server (used when DATABASE_URL is not set, including `just run`)
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_DOMAIN=localhost
DATABASE_NAME=ws_backend
DATABASE_SSL_MODE=disable

# Named environments for the justfile.
# `just export hetzner` / `just push hetzner` resolve the corresponding URL.
# DATABASE_URL_LOCAL is optional — leave blank to compose from the vars above.
DATABASE_URL_LOCAL=
DATABASE_URL_HETZNER=

# Coolify/Hetzner bootstrap (superuser URL, used by `just coolify-init`)
POSTGRES_ADMIN_URL=

# API
TRUSTED_PROXIES=127.0.0.1,192.168.1.1
PORT=8082
GIN_MODE=release
APP_ENV=development

# CORS. Comma-separated allowlist. Leave blank for permissive '*' (dev only).
# In prod set the web origins; the Capacitor mobile webview origins
# (capacitor://localhost, https://localhost, ionic://localhost) are appended
# automatically, so they do not need to be listed here.
# CORS_ALLOWED_ORIGINS=https://wikisubmission.org,https://www.wikisubmission.org

# ── Native mobile auth (Capacitor app: POST /api/v1/auth/mobile/{exchange,refresh})
# The mobile app signs in natively with Google / Apple and exchanges the provider
# ID token here for a backend session JWT. The session token is minted with the
# existing WS_BACKEND_JWT_SECRET (set elsewhere), so no new signing secret is
# needed. Each provider stays disabled until its audience allowlist below is set.
#
# WS_BACKEND_JWT_SECRET — shared HS256 secret, must match the frontend Auth.js
#   value (set in the web app's env too). Required for any mobile auth.
WS_BACKEND_JWT_SECRET=
#
# AUTH_GOOGLE_MOBILE_CLIENT_IDS — comma-separated Google OAuth client IDs accepted
#   as the id_token audience. Create these in Google Cloud Console > Credentials:
#   one OAuth client per platform (iOS, Android) plus the existing web client.
#   Format: <id>.apps.googleusercontent.com. JWKS is fetched from
#   https://www.googleapis.com/oauth2/v3/certs (no config needed).
AUTH_GOOGLE_MOBILE_CLIENT_IDS=
#
# AUTH_APPLE_BUNDLE_IDS — comma-separated Apple audiences: the app bundle id used
#   for native Sign in with Apple (e.g. org.wikisubmission.app) and, if used, the
#   Services ID (e.g. org.wikisubmission.signin). JWKS is fetched from
#   https://appleid.apple.com/auth/keys (no config needed). A nonce is required.
AUTH_APPLE_BUNDLE_IDS=
#
# Token lifetimes (Go duration strings). Optional — sensible defaults apply.
# Access token is short-lived (matches the web session); the long-lived mobile
# session is carried by the refresh token, redeemed at /auth/mobile/refresh.
# MOBILE_ACCESS_TOKEN_TTL=1h
# MOBILE_REFRESH_TOKEN_TTL=1440h

# OpenAI (only needed for `just embed-quran`)
OPENAI_API_KEY=

# Web Push (VAPID). Generate a pair with webpush.GenerateVAPIDKeys() or
# `npx web-push generate-vapid-keys`. The public key must also be exposed to
# the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wikisubmission.org

# FCM (mobile push, Capacitor app). The raw service-account JSON for the
# Firebase project (wikisubmission-notifications) — NOT a file path. Generate it
# in Firebase Console > Project settings > Service accounts > Generate new
# private key, then minify to one line (`jq -c . key.json`). Leave blank to
# disable FCM (NewFCMSenderFromEnv falls back to a no-op sender and logs a
# warning; web push via VAPID above is unaffected). The project id here must
# match the app's google-services.json / GoogleService-Info.plist.
FIREBASE_SERVICE_ACCOUNT_JSON=

# User data export (GET/POST /api/v1/me/export).
# All S3 + CloudFront access lives in ws-lib: the export is stored via ws-lib's
# authenticated POST /private/store endpoint over the internal network, which
# returns a 30-day signed download link shown in-app (no email, no AWS creds
# here). Leave WSLIB_BASE_URL or STORE_AUTH_SECRET blank to disable the feature
# (the endpoint then fails gracefully).
#
# WSLIB_BASE_URL: internal address of ws-lib, e.g. http://ws-lib:8080 (the
#   Docker service name + internal port on the shared Coolify network), NOT the
#   public https URL.
# STORE_AUTH_SECRET: shared HMAC secret; must match ws-lib's STORE_AUTH_SECRET.
WSLIB_BASE_URL=
STORE_AUTH_SECRET=
