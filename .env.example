# DB — local server (used when DATABASE_URL is not set, including `just run`)
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_DOMAIN=localhost
DATABASE_NAME=ws_backend
DATABASE_SSL_MODE=disable

# Named environments for the justfile.
# `just export railway` / `just push hetzner` resolve the corresponding URL.
# DATABASE_URL_LOCAL is optional — leave blank to compose from the vars above.
DATABASE_URL_LOCAL=
DATABASE_URL_RAILWAY=
DATABASE_URL_HETZNER=

# Coolify/Hetzner bootstrap (superuser URL, used by `just coolify-init`)
POSTGRES_ADMIN_URL=

# API
TRUSTED_PROXIES=127.0.0.1,192.168.1.1
PORT=8082
GIN_MODE=release
APP_ENV=development

# OpenAI (only needed for `just embed-quran`)
OPENAI_API_KEY=

# Web Push (VAPID). Generate a pair with webpush.GenerateVAPIDKeys() or
# `npx web-push generate-vapid-keys`. The public key must also be exposed to
# the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wikisubmission.org

# User data export (GET/POST /api/v1/me/export).
# All S3 + CloudFront access lives in ws-lib: the export is stored via ws-lib's
# authenticated POST /private/store endpoint over the internal network, which
# returns a 30-day signed download link shown in-app (no email, no AWS creds
# here). Leave WSLIB_BASE_URL or STORE_AUTH_SECRET blank to disable the feature
# (the endpoint then fails gracefully).
#
# WSLIB_BASE_URL: internal address of ws-lib, e.g. http://ws-lib:8080 (the
#   Docker service name + internal port on the shared Coolify network), NOT the
#   public https URL.
# STORE_AUTH_SECRET: shared HMAC secret; must match ws-lib's STORE_AUTH_SECRET.
WSLIB_BASE_URL=
STORE_AUTH_SECRET=
