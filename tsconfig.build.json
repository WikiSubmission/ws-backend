{
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"],
      "@prisma/*": ["src/modules/prisma/*"],
      "@logger/*": ["src/modules/logger/*"],
      "@modules": ["src/modules/index"]
    }
  }
}
